# Copier en `.env` et ajuster si besoin. Le `.env` réel n'est pas versionné.

# PostgreSQL
POSTGRES_DB=second_brain
POSTGRES_USER=second_brain
POSTGRES_PASSWORD=second_brain

# Ports exposés sur l'hôte
APP_PORT=8080
DB_PORT=5432
ADMINER_PORT=8081
MAILPIT_SMTP_PORT=1025
MAILPIT_WEB_PORT=8025

# Variables lues directement par l'application, pas par docker compose : celui-ci les
# fixe déjà pour le développement (voir le service `app` dans compose.yaml, qui pointe
# SPRING_MAIL_HOST/PORT vers le conteneur mailpit ci-dessus). Rappelées ici pour
# référence — à définir explicitement lors d'un déploiement hors docker compose (voir
# le README, section « Build de production ») :
# SPRING_MAIL_HOST=mailpit
# SPRING_MAIL_PORT=1025
# SECONDBRAIN_BASE_URL=http://localhost:8080
# SECONDBRAIN_NOTIFICATION_FROM=no-reply@second-brain.localhost
