# Copier en `.env` et ajuster si besoin. Le `.env` réel n'est pas versionné.

# PostgreSQL
POSTGRES_DB=second_brain
POSTGRES_USER=second_brain
POSTGRES_PASSWORD=second_brain

# Suffixe de la pile Docker. Vide dans le dépôt principal, `-<feature>` dans un worktree :
# il donne son nom au projet compose, donc ses propres conteneurs, réseau et volumes. Le
# skill `worktree` l'écrit tout seul ; ne pas le poser à la main ici.
STACK_SUFFIX=

# Ports exposés sur l'hôte
# Port unique publié pour l'application : le reverse proxy sert le front et l'API sous
# cette seule origine. L'application Java et le serveur Vite ne publient plus rien.
HTTP_PORT=8080
DB_PORT=5432
MAILPIT_SMTP_PORT=1025
MAILPIT_WEB_PORT=8025
# Dans un worktree, ces quatre ports sont décalés du même indice (8081/5433/1026/8026 pour
# le premier, et ainsi de suite) : c'est ce qui permet à deux features de tourner ensemble.

# Secret de signature des jetons d'accès (HS256, 32 octets minimum). compose.yaml fournit
# un défaut de développement ; `application.yml` n'en fournit aucun, donc tout déploiement
# hors docker compose DOIT définir la variable SECONDBRAIN_JWT_SECRET (JWT_SECRET n'existe
# que dans ce fichier et compose.yaml, qui l'y fait correspondre — hors Compose, c'est le
# nom SECONDBRAIN_JWT_SECRET qu'il faut poser). La valeur ci-dessous est une commodité de
# développement à ne jamais réutiliser ailleurs : HS256 est symétrique, un secret deviné
# permet de forger un jeton valide pour n'importe quel compte. Générer une vraie valeur
# avec `openssl rand -base64 48`.
JWT_SECRET=secret-de-developpement-second-brain-32-octets

# Variables lues directement par l'application, pas par docker compose : celui-ci les
# fixe déjà pour le développement (voir le service `app` dans compose.yaml, qui pointe
# SPRING_MAIL_HOST/PORT vers le conteneur mailpit ci-dessus). Rappelées ici pour
# référence — à définir explicitement lors d'un déploiement hors docker compose (voir
# le README, section « Build de production ») :
# SPRING_MAIL_HOST=mailpit
# SPRING_MAIL_PORT=1025
# SECONDBRAIN_BASE_URL=http://localhost:8080
# SECONDBRAIN_NOTIFICATION_FROM=no-reply@second-brain.localhost
